// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  books     Book[]
  mcqProgress MCQProgress[]
  shortProgress ShortProgress[]
  creativeProgress CreativeProgress[]
  scenarioProgress ScenarioProgress[]
}

enum ConceptType {
  CORE
  INTERMEDIATE
  ADVANCED
  PERIPHERAL
  MISC
}

model Book {
  id          String   @id @default(cuid())
  title       String
  description String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters    Chapter[]
}

model Chapter {
  id          String   @id @default(cuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id])
  order       Int      @default(0)
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subchapters Subchapter[]
}

model Subchapter {
  id          String   @id @default(cuid())
  chapterId   String
  chapter     Chapter  @relation(fields: [chapterId], references: [id])
  order       Int      @default(0)
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  mcqs        MCQQuestion[]
  shorts      ShortQuestion[]
  creatives   CreativeQuestion[]
  scenarios   ScenarioQuestion[]
}

model MCQQuestion {
  id           String      @id @default(cuid())
  subchapterId String
  subchapter   Subchapter  @relation(fields: [subchapterId], references: [id])
  prompt       String
  explanation  String?
  conceptType  ConceptType @default(CORE)
  concepts     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  choices      MCQChoice[]
  progress     MCQProgress[]
}

model MCQChoice {
  id          String      @id @default(cuid())
  questionId  String
  question    MCQQuestion @relation(fields: [questionId], references: [id])
  label       String
  text        String
  isCorrect   Boolean     @default(false)
  explanation String?
}

model MCQProgress {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  questionId     String
  question       MCQQuestion @relation(fields: [questionId], references: [id])
  seenCount      Int         @default(0)
  correctCount   Int         @default(0)
  lastReviewedAt DateTime?
  isLearned      Boolean     @default(false)

  @@unique([userId, questionId])
}

model ShortQuestion {
  id           String      @id @default(cuid())
  subchapterId String
  subchapter   Subchapter  @relation(fields: [subchapterId], references: [id])
  prompt       String
  answer       String
  conceptType  ConceptType @default(CORE)
  concepts     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  progress     ShortProgress[]
}

model ShortProgress {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  questionId     String
  question       ShortQuestion @relation(fields: [questionId], references: [id])
  seenCount      Int           @default(0)
  correctCount   Int           @default(0)
  lastReviewedAt DateTime?
  isLearned      Boolean       @default(false)

  @@unique([userId, questionId])
}

model CreativeQuestion {
  id           String      @id @default(cuid())
  subchapterId String
  subchapter   Subchapter  @relation(fields: [subchapterId], references: [id])
  prompt       String
  answer       String
  conceptType  ConceptType @default(CORE)
  concepts     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  progress     CreativeProgress[]
}

model CreativeProgress {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  questionId     String
  question       CreativeQuestion  @relation(fields: [questionId], references: [id])
  seenCount      Int               @default(0)
  correctCount   Int               @default(0)
  lastReviewedAt DateTime?
  isLearned      Boolean           @default(false)

  @@unique([userId, questionId])
}

model ScenarioQuestion {
  id           String      @id @default(cuid())
  subchapterId String
  subchapter   Subchapter  @relation(fields: [subchapterId], references: [id])
  prompt       String
  answer       String
  conceptType  ConceptType @default(CORE)
  concepts     Json?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  progress     ScenarioProgress[]
}

model ScenarioProgress {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id])
  questionId     String
  question       ScenarioQuestion  @relation(fields: [questionId], references: [id])
  seenCount      Int               @default(0)
  correctCount   Int               @default(0)
  lastReviewedAt DateTime?
  isLearned      Boolean           @default(false)

  @@unique([userId, questionId])
}
